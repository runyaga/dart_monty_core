# Dart
.dart_tool/
.packages
pubspec.lock
# ...except the proto generator's: tool/generate_proto.sh compiles
# protoc_plugin from it with --enforce-lockfile.
!tool/proto_gen/pubspec.lock
build/
coverage/

# Rust
native/worker/target/
# Worker executables from tool/build_worker.sh (contributor and CI builds).
lib/src/bin/
# DCM local config contains credentials — never commit
.dcm.yaml

# assets/ JS/WASM files ARE committed to git (Mode A asset distribution).
# Regenerate with: bash tool/prebuild.sh
# CI verifies no drift on every PR.

# macOS
.DS_Store

# Local mkdocs build artefacts
.venv-docs/
site_mkdocs/

# Assembled GitHub Pages site (build artifact; see tool/check_pages.sh)
site/

# tool/gate.sh step logs
.gate-logs/

# Agent scratch: worktrees and transient probe scripts. Untracked and NOT
# ignored, a subagent's throwaway probes were swept into a commit by a
# `git add -A` -- four of them shipped in what became 0aa5a63 before being
# pulled back out.
.claude/
probe*.dart
__pycache__/
