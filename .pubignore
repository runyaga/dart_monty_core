# from source (Toolchain prerequisites, Build) as well as maintainers.
dcm_options.yaml
analysis_options.yaml
dart_test.yaml

# Docs dir (non-standard name — pub convention is doc/)
docs/

# Local mkdocs scaffolding — used to generate llms.txt locally for the
