    "text": "hello\nworld\n"
   },
   "/data/b.bin": {
    "hex": "00ff10"
   },
   "/data/sub/c.txt": {
    "text": "c"
   },
   "/data/u.txt": {
    "text": "héllo ✓"
   }
  }
 },
